+// Reversal also reverses each equal-key group. Reverse those groups again
+// to retain the original payload order of this nonincreasing run.
+fn reverse_ordered<T: Radixable<K>, K: RadixKey>(
+    arr: &mut [T],
+    has_equal_keys: bool,
+) {
+    arr.reverse();
+    if has_equal_keys {
+        let mut start = 0;
+        while start < arr.len() {
+            let key = arr[start].into_key_type();
+            let mut end = start + 1;
+            while end < arr.len() && arr[end].into_key_type() == key {
+                end += 1;
+            }
+            arr[start..end].reverse();
+            start = end;
+        }
+    }
+}
