+// At the first ascending inversion only one of its two records can be the
+// single displaced record. Verify the remaining order before rotating. These
+// paths use no heap, and preserve ties by inserting a right-moving record
+// before later equals and a left-moving record after earlier equals.
+fn repair_single_displaced<T: Radixable<K>, K: RadixKey>(
+    arr: &mut [T],
+    inversion: usize,
+) -> bool {
+    let left = inversion - 1;
+    if (inversion + 1 == arr.len()
+        || arr[left].into_key_type() <= arr[inversion + 1].into_key_type())
+        && check_order::<T, K, false>(&arr[inversion + 1..]).0
+            == arr.len() - inversion - 1
+    {
+        let key = arr[inversion].into_key_type();
+        let destination = arr[..inversion]
+            .partition_point(|item| item.into_key_type() <= key);
+        arr[destination..=inversion].rotate_right(1);
+        return true;
+    }
+    if (left == 0
+        || arr[left - 1].into_key_type() <= arr[inversion].into_key_type())
+        && check_order::<T, K, false>(&arr[inversion..]).0
+            == arr.len() - inversion
+    {
+        let key = arr[left].into_key_type();
+        let destination = inversion
+            + arr[inversion..]
+                .partition_point(|item| item.into_key_type() < key);
+        arr[left..destination].rotate_left(1);
+        return true;
+    }
+    false
+}
