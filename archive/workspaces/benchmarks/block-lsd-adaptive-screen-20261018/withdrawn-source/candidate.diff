+#[test]
+fn test_sort_block_lsd_displaced_records() {
+    for n in [129, 257, 513] {
+        for group in [1, 4, 32] {
+            let sorted: Vec<_> = (0..n)
+                .map(|position| Record {
+                    key: (position / group) as u128,
+                    position,
+                })
+                .collect();
+            let positions = [0, 1, n / 4, n / 2, n - 2, n - 1];
+            for from in positions {
+                for to in positions {
+                    let mut input = sorted.clone();
+                    if from < to {
+                        input[from..=to].rotate_left(1);
+                    } else {
+                        input[to..=from].rotate_right(1);
+                    }
+                    for radix in [1, 4, 8] {
+                        for block_size in [1, 31, 512] {
+                            check_records(&input, radix, block_size);
+                        }
+                    }
+                    // A second displacement must either satisfy the same
+                    // complete-order proof or fall back to the radix path.
+                    input[n / 3..].rotate_right(1);
+                    check_records(&input, 8, 31);
+                }
+            }
+        }
+    }
+}
