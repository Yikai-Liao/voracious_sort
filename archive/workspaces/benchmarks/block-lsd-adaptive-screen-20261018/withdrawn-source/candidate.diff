+// The first monotone run is already proved. Verify the complete second run
+// before mutation; ordinary random inputs reject after a few comparisons.
+// The merge buffer shares the radix path's scratch allowance and is allocated
+// only after both runs are known, so the two paths never retain heap together.
+fn merge_two_runs<T: Radixable<K>, K: RadixKey>(
+    arr: &mut [T],
+    split: usize,
+    first_descending: bool,
+    first_has_equal_keys: bool,
+    scratch_len: usize,
+) -> bool {
+    let first = arr[split].into_key_type();
+    let (second_descending, second_has_equal_keys) =
+        match first_different_key::<T, K>(&arr[split + 1..], first) {
+            None => (false, true),
+            Some((equal_prefix, key)) => {
+                let suffix = &arr[split + equal_prefix..];
+                let descending = key < first;
+                let (end, ties) = if descending {
+                    check_order::<T, K, true>(suffix)
+                } else {
+                    check_order::<T, K, false>(suffix)
+                };
+                if end != suffix.len() {
+                    return false;
+                }
+                (descending, ties || equal_prefix > 0)
+            },
+        };
+    if first_descending {
+        reverse_ordered::<T, K>(&mut arr[..split], first_has_equal_keys);
+    }
+    if second_descending {
+        reverse_ordered::<T, K>(&mut arr[split..], second_has_equal_keys);
+    }
+    if arr[split - 1].into_key_type() <= arr[split].into_key_type() {
+        return true;
+    }
+    let capacity = scratch_len.min(split).min(arr.len() - split);
+    let mut buffer = Vec::with_capacity(capacity);
+    merge_bounded::<T, K>(arr, split, &mut buffer);
+    true
+}
+
+// Merge adjacent sorted runs stably. Buffer a complete shorter run when it
+// fits; otherwise split the longer run, partition the other at the same key,
+// and rotate their middle parts. Lower/upper bounds keep equal keys from the
+// original left run ahead of those from the original right run. Recursive
+// calls reuse one buffer and shrink the longer run, bounding stack depth.
+fn merge_bounded<T: Radixable<K>, K: RadixKey>(
+    arr: &mut [T],
+    mid: usize,
+    buffer: &mut Vec<T>,
+) {
+    if mid == 0
+        || mid == arr.len()
+        || arr[mid - 1].into_key_type() <= arr[mid].into_key_type()
+    {
+        return;
+    }
+    let right_len = arr.len() - mid;
+    if mid <= right_len && mid <= buffer.capacity() {
+        buffer.clear();
+        buffer.extend_from_slice(&arr[..mid]);
+        let (mut left, mut right, mut output) = (0, mid, 0);
+        while left < mid && right < arr.len() {
+            if buffer[left].into_key_type() <= arr[right].into_key_type() {
+                arr[output] = buffer[left];
+                left += 1;
+            } else {
+                arr[output] = arr[right];
+                right += 1;
+            }
+            output += 1;
+        }
+        arr[output..output + mid - left].copy_from_slice(&buffer[left..]);
+        return;
+    }
+    if right_len <= buffer.capacity() {
+        buffer.clear();
+        buffer.extend_from_slice(&arr[mid..]);
+        let (mut left, mut right, mut output) = (mid, right_len, arr.len());
+        while left > 0 && right > 0 {
+            output -= 1;
+            if arr[left - 1].into_key_type() > buffer[right - 1].into_key_type()
+            {
+                left -= 1;
+                arr[output] = arr[left];
+            } else {
+                right -= 1;
+                arr[output] = buffer[right];
+            }
+        }
+        arr[..right].copy_from_slice(&buffer[..right]);
+        return;
+    }
+    let (left_cut, right_cut) = if mid >= right_len {
+        let left_cut = mid / 2;
+        let key = arr[left_cut].into_key_type();
+        let right_cut =
+            mid + arr[mid..].partition_point(|item| item.into_key_type() < key);
+        (left_cut, right_cut)
+    } else {
+        let right_cut = mid + right_len / 2;
+        let key = arr[right_cut].into_key_type();
+        let left_cut =
+            arr[..mid].partition_point(|item| item.into_key_type() <= key);
+        (left_cut, right_cut)
+    };
+    arr[left_cut..right_cut].rotate_left(mid - left_cut);
+    let new_mid = left_cut + right_cut - mid;
+    let (left, right) = arr.split_at_mut(new_mid);
+    merge_bounded::<T, K>(left, left_cut, buffer);
+    merge_bounded::<T, K>(right, mid - left_cut, buffer);
 }
 
