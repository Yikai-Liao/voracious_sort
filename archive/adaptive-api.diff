+    }
+    let payload = std::rc::Rc::new(());
+    let mut arr = [
+        Local { key: 3, payload: &payload },
+        Local { key: 1, payload: &payload },
+    ];
+    sort_with_block_size(&mut arr, 8, 1);
+    assert_eq!(arr[0].key, 1);
+    assert!(std::ptr::eq(arr[0].payload, &payload));
+}
